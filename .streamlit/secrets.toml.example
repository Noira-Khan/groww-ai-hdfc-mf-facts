# Copy to .streamlit/secrets.toml locally, or paste these keys into the
# Streamlit Community Cloud "Secrets" editor. Never commit real keys.

GROQ_API_KEY = "replace-with-your-groq-api-key"
LLM_MODEL_ID = "openai/gpt-oss-120b"

# Optional. Change this to invalidate cached answers.
# CACHE_SALT = "replace-with-a-long-random-string"

# Optional. Speeds up the first download of the embedding model.
# HF_TOKEN = "replace-with-your-hugging-face-token"
